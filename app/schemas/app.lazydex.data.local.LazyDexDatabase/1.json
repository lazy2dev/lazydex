    "views": [
      {
        "viewName": "active_media_items",
        "createSql": "CREATE VIEW `${VIEW_NAME}` AS SELECT \n            m.id,\n            m.type,\n            m.format,\n            m.countryOfOrigin,\n            m.title,\n            m.titleEnglish,\n            m.titleRomaji,\n            m.titleNative,\n            m.coverImagePath,\n            m.coverImageUrl,\n            m.bannerImage,\n            m.description,\n            m.author,\n            COALESCE(u.userStatus, 'PLANNING') AS userStatus,\n            COALESCE(u.progress, 0.0) AS progress,\n            m.progressTotal,\n            COALESCE(u.secondaryProgress, 0.0) AS secondaryProgress,\n            m.secondaryProgressTotal,\n            u.scoreRaw,\n            COALESCE(u.repeat, 0) AS repeat,\n            COALESCE(u.notes, '') AS notes,\n            m.genres,\n            m.tags,\n            COALESCE(u.isPrivate, 0) AS isPrivate,\n            m.isAdult,\n            u.startYear,\n            u.startMonth,\n            u.startDay,\n            u.endYear,\n            u.endMonth,\n            u.endDay,\n            m.durationMinutes,\n            m.avgChapterLength,\n            m.lengthUnitOverride,\n            m.playbackSpeed,\n            m.averageScore,\n            COALESCE(u.createdAt, m.createdAt) AS createdAt,\n            m.updatedAt AS catalogUpdatedAt,\n            u.updatedAt AS userUpdatedAt,\n            m.deletedAt\n        FROM media_items m\n        LEFT JOIN user_data u ON u.mediaId = m.id\n        WHERE m.deletedAt IS NULL"
      }
    ],
